# Copy this file to .env.local for local development.
#
# DATABASE_URL is required at runtime for multiplayer/party features and
# high-scores. The build succeeds even without it (API routes will return
# 503 "database not configured" until a PostgreSQL connection string is
# provided).
#
# Examples:
#   Local:      postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   Vercel:     set in Project -> Storage / Environment Variables
#   Render/Railway/Neon/Supabase:  use the "External Database URL" from the dashboard
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
